{
  "name": "agentic-harness",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:install": "node ./scripts/dev-install.mjs",
    "lint": "pnpm -r lint",
